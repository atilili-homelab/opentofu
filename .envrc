use flake
# homelab/opentofu/.envrc — credentials AppRole OpenBao pour OpenTofu, via direnv
# Setup : `direnv allow` une fois dans le dossier. Requiert rbw déverrouillé.
# Se charge aussi depuis prod/ (direnv remonte l'arborescence).

if ! rbw unlocked >/dev/null 2>&1; then
    log_error "rbw verrouillé — lance 'rbw unlock' puis 'direnv reload'"
    exit 1
fi

# OpenBao vault
TF_VAR_login_approle_role_id="$(rbw get 'Openbao Opentofu Role_id')"
TF_VAR_login_approle_secret_id="$(rbw get 'Openbao Opentofu Secret_id')"
export TF_VAR_login_approle_role_id
export TF_VAR_login_approle_secret_id

# OVH bucket S3 tfstate
AWS_ACCESS_KEY_ID=$(rbw get ovh-s3-tfstate --field=username)
AWS_SECRET_ACCESS_KEY=$(rbw get ovh-s3-tfstate)
export AWS_ACCESS_KEY_ID
export AWS_SECRET_ACCESS_KEY
export AWS_DEFAULT_REGION=eu-west-par
export AWS_PAGER=""

# OVH api
OVH_CONSUMER_KEY="$(rbw get ovh-api-tofu -f consumer_key)"
OVH_APPLICATION_SECRET="$(rbw get ovh-api-tofu -f application_secret)"
OVH_APPLICATION_KEY="$(rbw get ovh-api-tofu -f application_key)"
export OVH_ENDPOINT="ovh-eu"
export OVH_APPLICATION_KEY
export OVH_APPLICATION_SECRET
export OVH_CONSUMER_KEY
