use flake

if rbw unlock >/dev/null 2>&1; then
    # Connexion OpenBao automatique si le token est absent ou expiré
    TF_VAR_openbao_yoann_password="$(rbw get openbao-yoann)"
    export TF_VAR_openbao_yoann_password
    export BAO_ADDR='http://sati.macopla.home:8200'
    if ! bao token lookup >/dev/null 2>&1; then
        printf '%s' "$TF_VAR_openbao_yoann_password" |
            bao write -field=token auth/userpass/login/yoann password=- |
            bao login -no-print -
    fi
    # Secrets d'infra lus dans OpenBao ; rbw ne garde qu'une copie de secours (passphrase, S3)
    read_secret() { bao kv get -mount=secret -format=json "opentofu/$1" | jq -e '.data.data'; }
    get() { jq -er --arg k "$2" '.[$k]' <<<"$1"; }
    # Pas de mode strict dans un .envrc : sans ce contrôle, un secret manquant donnerait une variable vide
    if {
        state="$(read_secret state)" &&
            ovh="$(read_secret ovh)" &&
            AWS_ACCESS_KEY_ID="$(get "$state" s3_access_key)" &&
            AWS_SECRET_ACCESS_KEY="$(get "$state" s3_secret_key)" &&
            TF_VAR_state_passphrase="$(get "$state" state_passphrase)" &&
            OVH_APPLICATION_KEY="$(get "$ovh" ovh_application_key)" &&
            OVH_APPLICATION_SECRET="$(get "$ovh" ovh_application_secret)" &&
            OVH_CONSUMER_KEY="$(get "$ovh" ovh_consumer_key)"
    }; then
        # Bucket S3 du tfstate et chiffrement du state (pbkdf2)
        export AWS_ACCESS_KEY_ID
        export AWS_SECRET_ACCESS_KEY
        export TF_VAR_state_passphrase
        export AWS_DEFAULT_REGION=eu-west-par
        export AWS_PAGER=""

        # API OVH, clé avec droits d'écriture (la CI a sa propre clé en lecture seule)
        export OVH_APPLICATION_KEY
        export OVH_APPLICATION_SECRET
        export OVH_CONSUMER_KEY
        export OVH_ENDPOINT="ovh-eu"
    else
        log_error "Lecture impossible dans OpenBao (secret/opentofu/state ou ovh) : outils chargés, pas les secrets"
    fi
else
    log_error "rbw n'a pas pu se déverrouiller : outils chargés, pas les secrets"
fi
