source_up

TF_VAR_openbao_yoann_password="$(rbw get openbao-yoann)"
export TF_VAR_openbao_yoann_password

# Connexion OpenBao automatique si le token est absent ou expiré
export BAO_ADDR='http://sati.macopla.home:8200'
if ! bao token lookup >/dev/null 2>&1; then
    printf '%s' "$TF_VAR_openbao_yoann_password" |
        bao write -field=token auth/userpass/login/yoann password=- |
        bao login -no-print -
fi
